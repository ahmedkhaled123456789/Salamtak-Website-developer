# demo = bundled sample content (no backend needed); live = care-backend
VITE_DATA_SOURCE=live
# Empty in development: Vite proxies /api to VITE_DEV_API_TARGET. Set it to the API origin
# (e.g. https://api.example.com) when the site is served from a different origin.
VITE_API_BASE_URL=
VITE_DEV_API_TARGET=http://localhost:5050
# Offset of the backend's platform timezone (Asia/Dubai by default)
VITE_PLATFORM_UTC_OFFSET=+04:00
# Public origin of this website, no trailing slash (canonical URLs, sitemap.xml, social previews). Required for production builds.
VITE_SITE_URL=
# true on a live site backed by a DEMO_MODE API (portfolio): shows the "demo data" badge noting that payments are simulated
VITE_PORTFOLIO_DEMO=
